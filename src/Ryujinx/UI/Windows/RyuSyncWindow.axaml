<window:StyleableAppWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:window="clr-namespace:Ryujinx.Ava.UI.Windows"
    mc:Ignorable="d"
    d:DesignWidth="520"
    d:DesignHeight="360"
    x:Class="Ryujinx.Ava.UI.Windows.RyuSyncWindow"
    Title="RyuSync - SSBU Netplay"
    Width="520"
    Height="360"
    MinWidth="460"
    MinHeight="330"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="12">
            <TextBlock FontSize="22" FontWeight="Bold" Text="RyuSync - SSBU Netplay" />
            <TextBlock TextWrapping="Wrap"
                       Text="Connect over Tailscale before launching SSBU. The player who sends the invitation is Player 1; the accepting player is Player 2." />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="PeerAddressBox"
                         Grid.Column="0"
                         Watermark="Tailscale IP or MagicDNS hostname" />
                <Button x:Name="InviteButton"
                        Grid.Column="1"
                        MinWidth="90"
                        Click="InviteButton_OnClick"
                        Content="Invite" />
            </Grid>

            <Border Padding="10" BorderThickness="1" BorderBrush="{DynamicResource ThemeControlBorderColor}" CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                    <TextBlock x:Name="RoleText" FontSize="12" Opacity="0.75" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="InvitationPanel" IsVisible="False" Spacing="8">
                <TextBlock x:Name="InvitationText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="90" Click="AcceptButton_OnClick" Content="Accept" />
                    <Button MinWidth="90" Click="DeclineButton_OnClick" Content="Decline" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReadyButton"
                        MinWidth="110"
                        Click="ReadyButton_OnClick"
                        Content="Ready"
                        IsEnabled="False" />
                <Button x:Name="DisconnectButton"
                        MinWidth="110"
                        Click="DisconnectButton_OnClick"
                        Content="Disconnect"
                        IsEnabled="False" />
            </StackPanel>

            <TextBlock Text="Input buffer: 3 frames (50 ms at 60 FPS). Motion controls and rumble are not synchronized in this version."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Opacity="0.75" />
            <TextBlock Text="After both players click Ready, launch the same SSBU version. The host's saved progress is transferred and verified before launch. The guest plays on a temporary copy; their own save is preserved. Session changes are saved only on the host."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Opacity="0.75" />
            <TextBlock Text="Experimental input synchronization: matching saves and startup randomness do not guarantee identical simulation. Cursor or gameplay drift can still occur. Keep game versions, DLC and mods identical."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Opacity="0.75" />
        </StackPanel>
    </ScrollViewer>
</window:StyleableAppWindow>
